CONFIG_LV_SDL_BUF_COUNT=2
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_USE_DEMO_WIDGETS=y
# CONFIG_LV_BUILD_EXAMPLES is not set
